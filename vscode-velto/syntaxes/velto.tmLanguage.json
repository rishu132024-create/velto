{
    "scopeName": "source.velto",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#function"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.velto",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.velto",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.velto",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.velto",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.velto",
                    "match": "\\b(if|else|while|for|in|break|continue|func|return|import)\\b"
                },
                {
                    "name": "constant.language.velto",
                    "match": "\\b(True|False|None)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.velto",
                    "match": "\\b(say|len|str|int|float|abs|min|max|range|sqrt|power|floor|ceil|sin|cos|tan|round|random|randint|choice|shuffle)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.velto",
                    "match": "==|!=|<=|>=|\\+|-|\\*|/|%|<|>|="
                }
            ]
        },
        "function": {
            "patterns": [
                {
                    "name": "entity.name.function.velto",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        }
    }
}
